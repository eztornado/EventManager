APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8099
APP_URL=http://localhost:8099
APP_DEBUG=true

DB_CONNECTION=sqlite

# Correos: bandeja interna, no se envían por SMTP.
MAIL_DRIVER=log

# Secreto para firmar los JWT. En producción usa una cadena aleatoria de
# al menos 32 caracteres.
# JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Pasarela de pago: demo (sin cargos reales) o stripe.
PAYMENT_PROVIDER=demo

# URL pública del frontend usada por Stripe para volver tras el pago.
# Con Vite en desarrollo: http://localhost:5173
FRONTEND_URL=http://localhost:8099

# Stripe Checkout. Rellena estas claves solo si PAYMENT_PROVIDER=stripe.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=eur

# ---- Despliegue con Docker / Coolify -------------------------------------
# La imagen define APP_HOST=0.0.0.0, APP_PORT=8080 y
# DB_DATABASE=storage/database.sqlite. Sobrescribe aquí si lo necesitas.
# APP_URL=https://tu-dominio.example
# FRONTEND_URL=https://tu-dominio.example
# SESSION_SECURE_COOKIE=true
# SEED_DEMO_DATA=false
# ADMIN_NAME=Administrador
# ADMIN_EMAIL=admin@tu-dominio.example
# ADMIN_PASSWORD=cambia-esta-clave
